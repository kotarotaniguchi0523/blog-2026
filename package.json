{
  "name": "blog-2026",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "knip": "node node_modules/knip/bin/knip.js",
    "test": "node --test tests/github/*.test.ts tests/docs7/*.test.ts",
    "docs7:dev": "node --env-file=docs7.env node_modules/@upstash/docs7/bin/docs7.mjs dev content --port 3333",
    "docs7:whoami": "node node_modules/@upstash/docs7/bin/docs7.mjs whoami",
    "docs7:login": "node node_modules/@upstash/docs7/bin/docs7.mjs login --no-browser",
    "docs7:preview": "node --env-file=docs7.env node_modules/@upstash/docs7/bin/docs7.mjs deploy content --preview",
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "editor": "node node_modules/@fumadocs-editor/studio/dist/cli.js --config fumadocs-studio.config.ts",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "types:check": "node node_modules/astro/bin/astro.mjs sync && node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fumadocs/astro": "^0.2.2",
    "@fumapress/astro": "0.1.0",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "astro": "^7.4.12",
    "fumadocs-core": "16.18.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "takumi-js": "^2.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fumadocs-editor/studio": "0.2.6",
    "@fumadocs-editor/ui": "0.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/docs7": "0.1.12",
    "emulate": "0.12.3",
    "knip": "6.43.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
